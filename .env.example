# BBD E-Commerce Intelligence & AI Analyst Environment Variables
# Copy this file to .env and fill in your API keys (optional)

# OpenAI API Key (optional - built-in smart analytics engine works without keys)
OPENAI_API_KEY=

# Groq API Key (optional - ultra-fast inference)
GROQ_API_KEY=

# Google Gemini API Key (optional)
GEMINI_API_KEY=

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# Preferred LLM Provider: auto | openai | groq | gemini | anthropic | offline
LLM_PROVIDER=auto
